---
export interface Props {
  title: string;
  description: string;
  features: string[];
  price: string;
  buttonText: string;
  buttonHref: string;
}
const { title, description, features, price, buttonText, buttonHref } =
  Astro.props;
---

<card-component>
  <h2 class="font-size-1-5">{title}</h2>
  <p class="font-size-1-125">{description}</p>
  <ul class="list margin-bottom-2">
    {features.map(feature => <li>{feature}</li>)}
  </ul>
  <div class="font-size-2 font-weight-6 margin-bottom-2">{price}</div>
  <button-component variant="primary" href={buttonHref}
    >{buttonText}</button-component
  >
</card-component>

<script>
  import '@components/card';
  import '@components/button';
</script>
