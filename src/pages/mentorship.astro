---
import Layout from '../layouts/default.astro';
import Card from '@components/Card.astro';
import SmartImage from '@components/SmartImage.astro';
import trainingImage from '@assets/images/smart-home/person-holding-phone.jpg';
import masteryImage from '@assets/images/smart-home/white-tablet-screen.jpg';
import diyImage from '@assets/images/smart-home/phone-camera-on-table.jpg';
---

<Layout
  title="Education & Training"
  description="Smart home education and training for Hudson Valley homeowners. Learn to use, manage, and get the most from your smart home with personalized coaching and hands-on guidance."
>
  <div class="column flex gap-3 page">
    <div class="gap grid">
      <h1 class="text-align-center">Education & Training</h1>
      <p class="hero-description text-align-center">
        Your smart home is only as good as your comfort using it. We offer
        personalized education and training so you can confidently manage your
        devices, automations, and apps — whether you're just getting started or
        want to go deeper.
      </p>
    </div>

    <div class="column gap-2 grid">
      <Card>
        <SmartImage src={trainingImage} alt="Person holding a smartphone" />
        <h3>New Homeowner Training</h3>
        <div class="flex-1">
          <p>
            Just moved into a smart home or had one installed? Learn exactly how
            everything works with hands-on, in-home training.
          </p>
          <ul>
            <li>Walkthrough of every device and app</li>
            <li>Voice assistant setup and commands</li>
            <li>Scene and schedule basics</li>
            <li>Home network overview</li>
            <li>Quick-reference guide for your system</li>
          </ul>
        </div>
      </Card>

      <Card>
        <SmartImage
          src={masteryImage}
          alt="Tablet with a screen showing content"
        />
        <h3>Getting the Most From Your System</h3>
        <div class="flex-1">
          <p>
            Go beyond the basics and unlock the full potential of your smart
            home with advanced tips, automations, and personalization.
          </p>
          <ul>
            <li>Advanced scenes and routines</li>
            <li>Automation design and triggers</li>
            <li>Energy-saving strategies</li>
            <li>Multi-user setup and family controls</li>
            <li>Security best practices</li>
          </ul>
        </div>
      </Card>

      <Card>
        <SmartImage src={diyImage} alt="Smartphone and camera on a table" />
        <h3>DIY & Expansion Guidance</h3>
        <div class="flex-1">
          <p>
            Ready to add to your system on your own? Get expert guidance on
            choosing, installing, and integrating new devices confidently.
          </p>
          <ul>
            <li>Device compatibility advice</li>
            <li>Installation walkthroughs</li>
            <li>Platform integration guidance</li>
            <li>Troubleshooting tips and tricks</li>
            <li>Where to start — and what to skip</li>
          </ul>
        </div>
      </Card>
    </div>

    <section class="gap grid">
      <h2 class="text-align-center">What You Can Expect</h2>
      <div class="mentor-grid">
        <div class="testimonial">
          "The in-home training made all the difference. I finally understand my
          system and actually enjoy using it every day."
          <div class="testimonial-author">— Happy Hudson Valley Homeowner</div>
        </div>
        <div class="testimonial">
          "They explained everything in plain language and set up automations
          that genuinely make my life easier. Highly recommended!"
          <div class="testimonial-author">— Local Client</div>
        </div>
      </div>
    </section>

    <section class="gap grid">
      <h2 class="text-align-center">Training Process</h2>
      <div class="mentor-grid">
        <Card>
          <h4>1. Initial Assessment</h4>
          <p>
            We begin with a discussion of your experience, goals, and the
            devices you use to create a personalized learning plan.
          </p>
        </Card>
        <Card>
          <h4>2. Hands-On Sessions</h4>
          <p>
            In-home or remote sessions focused on your needs—device basics,
            automation, or advanced features.
          </p>
        </Card>
        <Card>
          <h4>3. Practical Practice</h4>
          <p>
            Set up real scenes, schedules, and routines together so you gain
            confidence with hands-on practice.
          </p>
        </Card>
        <Card>
          <h4>4. Ongoing Support</h4>
          <p>
            Access resources, quick-reference guides, and continued support as
            you grow your smart home.
          </p>
        </Card>
      </div>
    </section>

    <section class="gap grid justify-content-center text-align-center">
      <h2>Ready to Master Your Smart Home?</h2>
      <p>
        Let's discuss your goals and create a training plan tailored for you.
      </p>
      <span class="space"></span>
      <div class="flex justify-content-center">
        <button-component
          href="https://calendar.app.google/JjnLtVR6mnM11FcS9"
          variant="primary"
          class="min-width-25vw"
        >
          Contact Us
        </button-component>
      </div>
    </section>
  </div>
</Layout>

<script>
  import '@components/button';
</script>

<style>
  a {
    font-weight: 800;
  }

  .mentor-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
    gap: 2rem;
  }

  .testimonial {
    background-color: var(--card-background-color);
    border-radius: 0.5rem;
    padding: 1.5rem;
    border-left: 4px solid var(--primary-color);
    font-style: italic;
  }

  .testimonial-author {
    font-weight: 600;
    margin-top: 1rem;
  }

  @media (max-width: 768px) {
    .hero-description {
      font-size: 1rem;
    }

    .mentor-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
