---
import ArrowForward from '@icons/arrow-forward.svg';
import Card from '@components/Card.astro';
import SmartImage from '@components/SmartImage.astro';
import coxFarmhouse from '@assets/images/hudson-valley/cox-farmhouse.jpg';
import Layout from '../layouts/default.astro';
---

<Layout
  title="Services"
  description="Subscription-based smart home care for the Hudson Valley, including design guidance, installation support, maintenance, and ongoing consultation."
>
  <div class="column flex gap-3 page">
    <div class="gap grid">
      <h1 class="text-align-center">Smart Home Care Plans</h1>
      <p class="hero-description text-align-center">
        Keep your smart home reliable as it grows. Our monthly plans pair expert
        guidance with setup, maintenance, and support for the systems you depend
        on every day.
      </p>
      <a class="button button-primary justify-self-center" href="/pricing">
        View monthly plans
      </a>
    </div>
    <SmartImage
      src={coxFarmhouse}
      alt="The historic Cox Farmhouse, an eighteenth-century stone house in Rhinebeck, New York"
      class="services-hero-image"
      loading="lazy"
    />
    <section class="gap grid justify-content-center text-align-center">
      <h2>
        <span class="section-chip subscription">Subscription</span> Services backed
        by care plans
      </h2>
      <p class="hero-description">
        Design, installation, and support — each paired with a monthly care plan
        from <strong>$25/month</strong> so your smart home stays reliable for years.
      </p>
    </section>
    <div class="column gap-2 grid">
      <Card>
        <h2 class="font-size-1-125 line-height-1-5">Smart Home Design</h2>
        <div class="flex-1">
          <p>
            Custom smart home system planning tailored to your home, lifestyle,
            and budget—focused on what matters most to you.
          </p>
          <div class="pricing-block">
            <p class="care-plan-line">
              <span class="plan-pill">Care plan</span>
              <strong>from $25/month</strong>
            </p>
            <p class="one-time-line">One-time design packages from $499</p>
          </div>
          <ul>
            <li>Home technology assessment</li>
            <li>Lighting, climate & security design</li>
            <li>Device and platform selection</li>
            <li>Network and connectivity planning</li>
          </ul>
        </div>
        <span></span>
        <a class="gap-0-5 align-self-flex-end" href="/services/design">
          Learn more about smart home design <ArrowForward />
        </a>
      </Card>
      <Card>
        <h2 class="font-size-1-125 line-height-1-5">Installation & Setup</h2>
        <div class="flex-1">
          <p>
            Professional installation and configuration of smart home devices.
            Clean wiring, proper placement, and reliable setup—done right.
          </p>
          <div class="pricing-block">
            <p class="care-plan-line">
              <span class="plan-pill">Care plan</span>
              <strong>from $25/month</strong>
            </p>
            <p class="one-time-line">
              One-time installation packages from $999
            </p>
          </div>
          <ul>
            <li>Device installation and mounting</li>
            <li>Wiring and network configuration</li>
            <li>App and platform setup</li>
            <li>System testing and optimization</li>
          </ul>
        </div>
        <span></span>
        <a class="gap-0-5 align-self-flex-end" href="/services/installation">
          Learn more about installation & setup <ArrowForward />
        </a>
      </Card>
      <Card>
        <h2 class="font-size-1-125 line-height-1-5">Consultation & Support</h2>
        <div class="flex-1">
          <p>
            Expert guidance for smart home challenges—advice on devices,
            platforms, troubleshooting, and long-term system strategy.
          </p>
          <div class="pricing-block">
            <p class="care-plan-line">
              <span class="plan-pill">Care plan</span>
              <strong>from $25/month</strong>
            </p>
            <p class="one-time-line">One-time assessments from $199</p>
          </div>
          <ul class="flex-1">
            <li>Smart home assessments and advice</li>
            <li>Device and platform recommendations</li>
            <li>Troubleshooting and repairs</li>
            <li>Ongoing support and maintenance</li>
          </ul>
        </div>
        <span></span>
        <a class="gap-0-5 align-self-flex-end" href="/services/consultation">
          Learn more about consultation & support <ArrowForward />
        </a>
      </Card>
    </div>
    <section class="gap grid justify-content-center text-align-center">
      <h2>Ready to Get Started?</h2>
      <p>Let's connect and design the perfect smart home solution for you.</p>
      <span class="space"></span>
      <div class="flex justify-content-center">
        <button-component
          href="https://calendar.app.google/JjnLtVR6mnM11FcS9"
          variant="primary"
          class="min-width-25vw"
        >
          Contact Us
        </button-component>
      </div>
    </section>
  </div>
</Layout>

<script>
  import '@components/button';
</script>

<style>
  :global(.services-hero-image) {
    margin-inline: auto;
    max-width: 30rem;
  }

  .pricing-block {
    background: var(--color-sky-50);
    border: 1px solid var(--color-sky-200);
    border-radius: 0.5rem;
    color: var(--color-neutral-800);
    display: grid;
    gap: 0.25rem;
    padding: 0.75rem 1rem;
  }

  .care-plan-line {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
  }

  .care-plan-line strong {
    color: var(--color-neutral-900);
  }

  .plan-pill {
    background: var(--color-sky-700, var(--color-sky-500));
    border-radius: 999px;
    color: #fff;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    line-height: 1.4;
    padding: 0.25rem 0.6rem;
    text-transform: uppercase;
  }

  .one-time-line {
    color: var(--color-neutral-600);
    font-size: 0.875rem;
    margin: 0;
  }
</style>
