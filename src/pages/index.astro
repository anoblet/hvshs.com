---
import Layout from '../layouts/default.astro';
import { getImage } from 'astro:assets';
import catskills from '@assets/images/hudson-valley/catskills-shawangunk.jpg';
import walkway from '@assets/images/hudson-valley/walkway-foggy.jpg';
import midHudson from '@assets/images/hudson-valley/mid-hudson-bridge.jpg';
import blithewood from '@assets/images/hudson-valley/hudson-catskills-blithewood.jpg';
import lighthouse from '@assets/images/hudson-valley/saugerties-lighthouse.jpg';
import shawangunk from '@assets/images/hudson-valley/shawangunk-verkeerderkill.jpg';

const heroSlides = await Promise.all(
  [
    {
      src: catskills,
      alt: 'Catskill Mountains panorama seen from the Shawangunk Ridge near Kerhonkson',
    },
    {
      src: walkway,
      alt: 'Walkway Over the Hudson railroad bridge spanning the Hudson River between Poughkeepsie and Highland',
    },
    {
      src: midHudson,
      alt: 'Mid-Hudson Bridge and Poughkeepsie viewed from Franny Reese State Park in Highland',
    },
    {
      src: blithewood,
      alt: 'Hudson River and the Catskill Escarpment viewed from North Germantown',
    },
    {
      src: lighthouse,
      alt: 'Saugerties Lighthouse on the Hudson River',
    },
    {
      src: shawangunk,
      alt: 'Shawangunk Ridge seen from Bear Hill Preserve near Cragsmoor in autumn',
    },
  ].map(async ({ src, alt }) => {
    const optimized = await getImage({
      src,
      widths: [640, 960, 1280, 1920],
      sizes: '100vw',
      format: 'webp',
    });
    return {
      src: optimized.src,
      srcset: optimized.srcSet.attribute,
      alt,
    };
  })
);

const heroSlidesJson = JSON.stringify(heroSlides);
---

<Layout
  title="Hudson Valley Smart Home Services"
  description="Hudson Valley Smart Home Services - Professional smart home design, installation, and management for clients across the Hudson Valley. Lighting, climate, security, and entertainment automation."
>
  <div class="width-100 max-width-64 margin-auto">
    <hero-component images={heroSlidesJson}></hero-component>
  </div>
</Layout>
<script>
  import '@components/button';
  import '@components/hero';
</script>
