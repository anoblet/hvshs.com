---
import Layout from '../layouts/default.astro';
import { getImage } from 'astro:assets';
import aqaraLogo from '@assets/logos/aqara.svg';
import bluetoothLogo from '@assets/logos/bluetooth.svg';
import inovelliLogo from '@assets/logos/inovelli.png';
import philipsHueLogo from '@assets/logos/philips-hue.svg';
import tpLinkLogo from '@assets/logos/tp-link.png';
import thirdRealityLogo from '@assets/logos/third-reality.svg';
import wifiLogo from '@assets/logos/wifi.svg';
import zWaveLogo from '@assets/logos/z-wave.svg';
import zigbeeLogo from '@assets/logos/zigbee.svg';
import peekamoose from '@assets/images/hudson-valley/peekamoose-overlook-panorama.jpg';
import stormKing from '@assets/images/hudson-valley/storm-king-sunrise.jpg';
import bearMountain from '@assets/images/hudson-valley/bear-mountain-view.jpg';
import olanaSunset from '@assets/images/hudson-valley/olana-sunset.jpg';
import esopus from '@assets/images/hudson-valley/esopus-lighthouse.jpg';
import minnewaska from '@assets/images/hudson-valley/lake-minnewaska.jpg';

const heroSlides = await Promise.all(
  [
    {
      src: peekamoose,
      alt: 'Catskill Mountains panorama from the Great Southern Overlook on Peekamoose Mountain',
    },
    {
      src: stormKing,
      alt: 'Sunrise over the Hudson Highlands at Storm King State Park',
    },
    {
      src: bearMountain,
      alt: 'Bear Mountain rising above the Hudson River from Bear Mountain Bridge Road',
    },
    {
      src: olanaSunset,
      alt: 'The Rip Van Winkle Bridge, Hudson River, and Catskill Mountains at sunset from Olana',
    },
    {
      src: esopus,
      alt: 'Esopus Meadows Lighthouse in the fog on the Hudson River',
    },
    {
      src: minnewaska,
      alt: 'Lake Minnewaska in the Minnewaska State Park Preserve',
    },
  ].map(async ({ src, alt }) => {
    const optimized = await getImage({
      src,
      widths: [640, 960, 1280, 1920],
      sizes: '100vw',
      format: 'webp',
    });
    return {
      src: optimized.src,
      srcset: optimized.srcSet.attribute,
      alt,
    };
  })
);

const heroSlidesJson = JSON.stringify(heroSlides);

const logos = [
  {
    src: 'https://cdn.shopify.com/s/files/1/1354/7835/files/logoSvg.svg?12380900890489450926',
    alt: 'August',
    href: 'https://august.com/',
    keepColors: true,
  },
  { src: aqaraLogo.src, alt: 'Aqara', href: 'https://www.aqara.com/' },
  {
    src: bluetoothLogo.src,
    alt: 'Bluetooth',
    href: 'https://www.bluetooth.com/',
    keepColors: true,
  },
  {
    src: 'https://upload.wikimedia.org/wikipedia/commons/a/ab/New_Home_Assistant_logo.svg',
    alt: 'Home Assistant',
    href: 'https://www.home-assistant.io/',
    keepColors: true,
  },
  {
    src: inovelliLogo.src,
    alt: 'Inovelli',
    href: 'https://www.inovelli.com/',
    keepColors: true,
  },
  {
    src: philipsHueLogo.src,
    alt: 'Philips Hue',
    href: 'https://www.philips-hue.com/',
    keepColors: true,
  },
  {
    src: tpLinkLogo.src,
    alt: 'TP-Link',
    href: 'https://www.tp-link.com/',
    keepColors: true,
  },
  {
    src: thirdRealityLogo.src,
    alt: 'Third Reality',
    href: 'https://thirdreality.com/',
  },
  {
    src: wifiLogo.src,
    alt: 'Wi-Fi',
    href: 'https://www.wi-fi.org/',
    keepColors: true,
  },
  {
    src: zWaveLogo.src,
    alt: 'Z-Wave',
    href: 'https://z-wavealliance.org/',
    keepColors: true,
  },
  {
    src: zigbeeLogo.src,
    alt: 'Zigbee',
    href: 'https://csa-iot.org/all-solutions/zigbee/',
  },
];
---

<Layout
  title="Hudson Valley Smart Home Solutions"
  description="Hudson Valley Smart Home Solutions - subscription-based smart home design, installation, maintenance, and support for lighting, climate, security, and entertainment automation."
  fullBleed
>
  <section
    class="logo-carousel"
    aria-label="Smart home technologies we support"
  >
    <button
      class="logo-carousel__nav logo-carousel__nav--prev"
      aria-label="Previous logos"
    >
      <svg viewBox="0 -960 960 960" aria-hidden="true">
        <path
          d="m313-440 224 224-57 56-320-320 320-320 57 56-224 224h487v80H313Z"
        ></path>
      </svg>
    </button>
    <div class="logo-carousel__track">
      {
        [0, 1].map(group => (
          <div class="logo-carousel__group" aria-hidden={group === 1}>
            {logos.map(({ src, alt, href, keepColors }) => (
              <a
                href={href}
                target="_blank"
                rel="noreferrer"
                tabindex={group === 1 ? -1 : undefined}
              >
                <img
                  src={src}
                  alt={alt}
                  data-logo={alt}
                  class:list={[{ 'logo-carousel__img--color': keepColors }]}
                />
              </a>
            ))}
          </div>
        ))
      }
    </div>
    <button
      class="logo-carousel__nav logo-carousel__nav--next"
      aria-label="Next logos"
    >
      <svg viewBox="0 -960 960 960" aria-hidden="true">
        <path
          d="M647-440H160v-80h487L423-744l57-56 320 320-320 320-57-56 224-224Z"
        ></path>
      </svg>
    </button>
  </section>
  <hero-component images={heroSlidesJson}></hero-component>
</Layout>

<style>
  .logo-carousel {
    /* Clears the fixed navigation-component nav now that the carousel is the
       first element on the page; 5rem matches the non-full-bleed main padding
       convention. */
    padding-top: 5rem;
    position: relative;
    width: 100%;
    overflow: hidden;
    background: #fff;
  }

  .logo-carousel:hover .logo-carousel__track {
    animation-play-state: paused;
  }

  .logo-carousel__nav {
    position: absolute;
    /* Center vertically on the carousel's content area (below the 5rem top
       padding), not the full carousel box, so the buttons never sit under
       the fixed nav at short viewport heights. */
    top: calc(5rem + (100% - 5rem) / 2);
    transform: translateY(-50%);
    z-index: 2;
    width: 2.5rem;
    height: 2.5rem;
    border: none;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.9);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s;
  }

  .logo-carousel__nav:hover {
    background: #fff;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  }

  .logo-carousel__nav svg {
    width: 1.5rem;
    height: 1.5rem;
    fill: #333;
  }

  .logo-carousel__nav--prev {
    left: 1rem;
  }

  .logo-carousel__nav--next {
    right: 1rem;
  }

  .logo-carousel__track {
    display: flex;
    align-items: center;
    width: max-content;
    animation: logo-carousel-scroll 28s linear infinite reverse;
  }

  .logo-carousel__group {
    display: flex;
    align-items: center;
    gap: 2rem;
    padding: 0.75rem 2rem;
  }

  .logo-carousel a {
    display: grid;
    width: 8rem;
    height: 3.5rem;
    flex: 0 0 8rem;
    place-items: center;
    border-radius: 0.25rem;
    background: #f5f5f5;
  }

  .logo-carousel img {
    display: block;
    width: 6rem;
    height: 2.5rem;
    object-fit: contain;
    filter: brightness(0);
  }

  .logo-carousel img.logo-carousel__img--color,
  .logo-carousel img[data-logo='August'],
  .logo-carousel img[data-logo='Bluetooth'],
  .logo-carousel img[data-logo='Inovelli'],
  .logo-carousel img[data-logo='Philips Hue'],
  .logo-carousel img[data-logo='TP-Link'],
  .logo-carousel img[data-logo='Wi-Fi'],
  .logo-carousel img[data-logo='Z-Wave'] {
    filter: none;
  }

  .logo-carousel::before,
  .logo-carousel::after {
    position: absolute;
    z-index: 1;
    top: 0;
    bottom: 0;
    width: 4rem;
    content: '';
    pointer-events: none;
  }

  .logo-carousel::before {
    left: 0;
    background: linear-gradient(to right, #fff, rgb(255 255 255 / 0%));
  }

  .logo-carousel::after {
    right: 0;
    background: linear-gradient(to left, #fff, rgb(255 255 255 / 0%));
  }

  @keyframes logo-carousel-scroll {
    from {
      transform: translateX(0);
    }

    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .logo-carousel__track {
      animation: none;
    }
  }

  @media (max-width: 768px) {
    .logo-carousel a {
      width: 6rem;
      height: 3rem;
      flex: 0 0 6rem;
    }

    .logo-carousel img {
      width: 4.5rem;
      height: 2rem;
    }

    .logo-carousel__group {
      gap: 1.5rem;
      padding: 0.5rem 1.5rem;
    }

    .logo-carousel__nav {
      width: 2rem;
      height: 2rem;
    }

    .logo-carousel__nav svg {
      width: 1.25rem;
      height: 1.25rem;
    }
  }

  @media (max-width: 480px) {
    .logo-carousel a {
      width: 5rem;
      height: 2.5rem;
      flex: 0 0 5rem;
    }

    .logo-carousel img {
      width: 3.75rem;
      height: 1.5rem;
    }

    .logo-carousel__group {
      gap: 1rem;
      padding: 0.5rem 1rem;
    }
  }
</style>
<script>
  import '@components/button';
  import '@components/hero';

  // Logo carousel navigation
  const carousel = document.querySelector('.logo-carousel');
  const track = carousel?.querySelector('.logo-carousel__track');
  const prevBtn = carousel?.querySelector('.logo-carousel__nav--prev');
  const nextBtn = carousel?.querySelector('.logo-carousel__nav--next');

  if (track && prevBtn && nextBtn) {
    const getScrollAmount = () => {
      const logo = track.querySelector('a');
      if (!logo) return 200;
      const style = getComputedStyle(logo);
      const width = logo.offsetWidth;
      const marginRight = parseInt(style.marginRight) || 0;
      return width + marginRight;
    };

    let currentOffset = 0;
    const maxOffset = track.scrollWidth / 2;

    const updatePosition = () => {
      track.style.transform = `translateX(${currentOffset}px)`;
    };

    prevBtn.addEventListener('click', () => {
      // Pause animation
      track.style.animationPlayState = 'paused';

      // If animation is running, get current position
      if (!currentOffset) {
        const computed = getComputedStyle(track);
        const matrix = new DOMMatrix(computed.transform);
        currentOffset = matrix.m41;
      }

      currentOffset += getScrollAmount();
      if (currentOffset > 0) currentOffset = 0;
      updatePosition();
    });

    nextBtn.addEventListener('click', () => {
      // Pause animation
      track.style.animationPlayState = 'paused';

      // If animation is running, get current position
      if (!currentOffset) {
        const computed = getComputedStyle(track);
        const matrix = new DOMMatrix(computed.transform);
        currentOffset = matrix.m41;
      }

      currentOffset -= getScrollAmount();
      if (currentOffset < -maxOffset)
        currentOffset = -maxOffset + getScrollAmount();
      updatePosition();
    });
  }
</script>
