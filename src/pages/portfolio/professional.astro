---
import automationImage from '@assets/images/smart-home/devices-on-table-2.jpg';
import avImage from '@assets/images/smart-home/monitor-keyboard-setup.jpg';
import accessImage from '@assets/images/smart-home/person-key-to-door.jpg';
import lightingImage from '@assets/images/smart-home/smart-devices-flatlay.jpg';
import hvacImage from '@assets/images/smart-home/thermostat-19-5.jpg';
import Card from '@components/Card.astro';
import SmartImage from '@components/SmartImage.astro';
import Tag from '@components/Tag.astro';
import Layout from '@layouts/default.astro';
---

<Layout
  title="Commercial Installations"
  description="Commercial smart home and building automation for Hudson Valley businesses. Energy-efficient lighting, access control, HVAC automation, and AV systems that save time and money."
>
  <div class="column flex gap page">
    <div class="gap grid justify-content-center text-align-center">
      <h1>Commercial Installations</h1>
      <p class="bold-5 max-width-56">
        Smart technology for local businesses — efficient lighting, secure
        access, and automated environments that reduce costs and improve daily
        operations.
      </p>
    </div>
    <div class="space-0-5"></div>
    <Card>
      <SmartImage
        src={lightingImage}
        alt="Smart home gadgets including a keyboard and light bulbs laid out flat"
      />
      <h2>Energy-Efficient Lighting</h2>
      <div class="flex-1">
        <ul>
          <li>
            Automated lighting control for offices, retail spaces, and
            storefronts.
          </li>
          <li>
            <strong>Occupancy-Based Control:</strong> Lights that respond to presence
            — on when needed, off when not.
          </li>
          <li>
            <strong>Scheduling:</strong> Lighting that follows business hours automatically,
            including holidays and after-hours cleanups.
          </li>
          <li>Significant energy and cost savings with usage reporting.</li>
        </ul>
      </div>
      <div class="flex flex-wrap gap-0-5 justify-content-center tags">
        <Tag>Lighting Control</Tag>
        <Tag>Occupancy Sensors</Tag>
        <Tag>Scheduling</Tag>
        <Tag>Energy Savings</Tag>
      </div>
    </Card>
    <Card>
      <SmartImage src={accessImage} alt="Person holding a key at a door" />
      <h2>Access Control & Security</h2>
      <div class="flex-1">
        <ul>
          <li>
            Smart locks and access control for offices, warehouses, and
            storefronts.
          </li>
          <li>
            <strong>Keyless Entry:</strong> Employee codes and schedules that revoke
            access instantly when needed.
          </li>
          <li>
            <strong>Video Surveillance:</strong> Cameras with remote viewing and
            recorded archives.
          </li>
          <li>Integrated alarm monitoring and instant notifications.</li>
        </ul>
      </div>
      <div class="flex flex-wrap gap-0-5 justify-content-center tags">
        <Tag>Smart Locks</Tag>
        <Tag>Access Control</Tag>
        <Tag>Video Surveillance</Tag>
        <Tag>Alarm Integration</Tag>
      </div>
    </Card>
    <Card>
      <SmartImage
        src={hvacImage}
        alt="Smart thermostat displaying 19.5 degrees"
      />
      <h2>HVAC Automation</h2>
      <div class="flex-1">
        <ul>
          <li>
            Smart thermostat and HVAC control for comfortable, efficient
            workplaces.
          </li>
          <li>
            <strong>Zone Control:</strong> Heat and cool only the areas in use, when
            they're in use.
          </li>
          <li>
            <strong>Energy Monitoring:</strong> Track usage across locations and
            identify savings opportunities.
          </li>
          <li>Remote management from anywhere.</li>
        </ul>
      </div>
      <div class="flex flex-wrap gap-0-5 justify-content-center tags">
        <Tag>Smart Thermostats</Tag>
        <Tag>Zone Control</Tag>
        <Tag>Energy Monitoring</Tag>
        <Tag>Remote Management</Tag>
      </div>
    </Card>
    <Card>
      <SmartImage src={avImage} alt="Computer monitor and keyboard setup" />
      <h2>Conference & AV Systems</h2>
      <div class="flex-1">
        <ul>
          <li>
            Smart conference rooms with one-touch video calls, presentations,
            and lighting scenes.
          </li>
          <li>
            <strong>One-Touch Start:</strong> Lights, screen, and audio ready with
            a single button press.
          </li>
          <li>
            <strong>Reliable Video:</strong> Professional video conferencing that
            just works for every meeting.
          </li>
          <li>Background music and paging for lobbies and common areas.</li>
        </ul>
      </div>
      <div class="flex flex-wrap gap-0-5 justify-content-center tags">
        <Tag>Conference Rooms</Tag>
        <Tag>Video Conferencing</Tag>
        <Tag>AV Control</Tag>
        <Tag>Scenes</Tag>
      </div>
    </Card>
    <Card>
      <SmartImage
        src={automationImage}
        alt="Smart home devices grouped on a table"
      />
      <h2>Building Automation</h2>
      <div class="flex-1">
        <ul>
          <li>
            Connected systems that bring lighting, climate, security, and energy
            together on one platform.
          </li>
          <li>
            <strong>Central Control:</strong> Manage your entire building from one
            dashboard, in the office or remotely.
          </li>
          <li>
            <strong>Automation:</strong> Open/close, lock/unlock, and optimize based
            on time, presence, and conditions.
          </li>
          <li>Scalable solutions that grow with your business.</li>
        </ul>
      </div>
      <div class="flex flex-wrap gap-0-5 justify-content-center tags">
        <Tag>Integration</Tag>
        <Tag>Central Control</Tag>
        <Tag>Automation</Tag>
        <Tag>Scalable</Tag>
      </div>
    </Card>
  </div>
</Layout>
