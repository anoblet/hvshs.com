---
import Card from '@components/Card.astro';
import Tag from '@components/Tag.astro';
import Layout from '@layouts/default.astro';
---

<Layout
  title="Residential Installations"
  description="Residential smart home installations across the Hudson Valley. Whole-home lighting, climate, security, and entertainment systems tailored to your family's lifestyle."
>
  <div class="column flex gap page">
    <div class="gap grid justify-content-center text-align-center">
      <h1>Residential Installations</h1>
      <p class="bold-5 max-width-56">
        Smart home installations that make everyday life more comfortable,
        secure, and energy-efficient — tailored to how your family lives.
      </p>
    </div>
    <div class="space-0-5"></div>
    <Card>
      <h2>Whole-Home Lighting</h2>
      <div class="flex-1">
        <ul>
          <li>
            Automated lighting throughout the home with smart switches, dimmers,
            and scene controls.
          </li>
          <li>
            <strong>Morning & Evening Scenes:</strong> Gradual wake-up lighting and
            winding-down scenes that match your routines.
          </li>
          <li>
            <strong>Energy Efficiency:</strong> Lights that turn off when rooms are
            empty and dim automatically to save power.
          </li>
          <li>
            Voice and app control for every room — from the kitchen to the
            bedrooms.
          </li>
        </ul>
      </div>
      <div class="flex flex-wrap gap-0-5 justify-content-center tags">
        <Tag>Smart Switches</Tag>
        <Tag>Smart Bulbs</Tag>
        <Tag>Scenes</Tag>
        <Tag>Voice Control</Tag>
        <Tag>Energy Savings</Tag>
      </div>
    </Card>
    <Card>
      <h2>Climate & Comfort</h2>
      <div class="flex-1">
        <ul>
          <li>
            Smart thermostat installation and configuration for year-round
            comfort.
          </li>
          <li>
            <strong>Adaptive Scheduling:</strong> Heating and cooling that adjusts
            automatically to your daily routines.
          </li>
          <li>
            <strong>Remote Control:</strong> Adjust your home's temperature from
            anywhere with your phone.
          </li>
          <li>
            Energy monitoring that helps you understand and reduce your usage
            and bills.
          </li>
        </ul>
      </div>
      <div class="flex flex-wrap gap-0-5 justify-content-center tags">
        <Tag>Smart Thermostats</Tag>
        <Tag>Zoned Climate</Tag>
        <Tag>Energy Monitoring</Tag>
        <Tag>Remote Control</Tag>
      </div>
    </Card>
    <Card>
      <h2>Home Security</h2>
      <div class="flex-1">
        <ul>
          <li>
            Integrated security with cameras, doorbells, sensors, and smart
            locks for complete peace of mind.
          </li>
          <li>
            <strong>Arrival & Departure:</strong> Automations that arm your system
            and lock your doors when you leave, and disarm on your return.
          </li>
          <li>
            <strong>Instant Alerts:</strong> Real-time notifications when motion
            or activity is detected.
          </li>
          <li>
            Video doorbells that let you see and speak with visitors from
            anywhere.
          </li>
        </ul>
      </div>
      <div class="flex flex-wrap gap-0-5 justify-content-center tags">
        <Tag>Smart Cameras</Tag>
        <Tag>Video Doorbells</Tag>
        <Tag>Motion Sensors</Tag>
        <Tag>Smart Locks</Tag>
        <Tag>Alerts</Tag>
      </div>
    </Card>
    <Card>
      <h2>Entertainment & Audio</h2>
      <div class="flex-1">
        <ul>
          <li>
            Smart TVs, streaming, and whole-home audio installed and connected
            for effortless entertainment.
          </li>
          <li>
            <strong>Whole-Home Audio:</strong> Music that follows you from room to
            room, controlled by voice or app.
          </li>
          <li>
            <strong>Movie Mode:</strong> Lighting that dims and audio that focuses
            the moment a movie starts.
          </li>
          <li>
            Reliable streaming throughout the home on a properly configured
            network.
          </li>
        </ul>
      </div>
      <div class="flex flex-wrap gap-0-5 justify-content-center tags">
        <Tag>Smart TV</Tag>
        <Tag>Whole-Home Audio</Tag>
        <Tag>Streaming</Tag>
        <Tag>Voice Control</Tag>
      </div>
    </Card>
    <Card>
      <h2>Automation & Scenes</h2>
      <div class="flex-1">
        <ul>
          <li>
            Connected automations that bring your whole home together — scenes,
            schedules, and routines that just work.
          </li>
          <li>
            <strong>Good Morning:</strong> Lights on, thermostat up, and news playing
            — all with a single phrase.
          </li>
          <li>
            <strong>Goodnight:</strong> All lights off, doors locked, and security
            armed with one command.
          </li>
          <li>Personalization that evolves with your routines and needs.</li>
        </ul>
      </div>
      <div class="flex flex-wrap gap-0-5 justify-content-center tags">
        <Tag>Scenes</Tag>
        <Tag>Schedules</Tag>
        <Tag>Routines</Tag>
        <Tag>Voice Assistant</Tag>
      </div>
    </Card>
  </div>
</Layout>
