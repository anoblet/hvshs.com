---
import ArrowForward from '@icons/arrow-forward.svg';
import Card from '@components/Card.astro';
import SmartImage from '@components/SmartImage.astro';
import bearMountainView from '@assets/images/hudson-valley/bear-mountain-view.jpg';
import Layout from '../layouts/default.astro';
---

<Layout
  title="Projects"
  description="Smart home installation projects across the Hudson Valley. Explore residential and commercial installations showcasing lighting, climate, security, and automation expertise."
>
  <div class="column flex gap-3 page">
    <div class="gap grid">
      <h1 class="text-align-center">Projects</h1>
      <SmartImage
        src={bearMountainView}
        alt="Bear Mountain rising above the Hudson River in the Hudson Highlands"
        loading="eager"
      />
      <p class="hero-description text-align-center">
        Smart home installations across the Hudson Valley — from cozy single
        rooms to full commercial systems. See how we help homes and businesses
        work smarter.
      </p>
    </div>
    <div class="column gap-2 grid">
      <Card>
        <h3>Residential Installations</h3>
        <div class="flex-1">
          <p>
            Whole-home automation for local families — lighting, climate,
            security, and entertainment systems tailored to daily life.
          </p>
          <ul>
            <li>Whole-home lighting and scenes</li>
            <li>Smart climate and energy savings</li>
            <li>Security cameras and smart locks</li>
            <li>Entertainment and whole-home audio</li>
          </ul>
        </div>
        <a class="gap-0-5 justify-content-flex-end" href="/portfolio/personal">
          View projects <ArrowForward />
        </a>
      </Card>
      <Card>
        <h3>Commercial Installations</h3>
        <div class="flex-1">
          <p>
            Smart technology for local businesses — efficient lighting, secure
            access, and automated environments that save time and money.
          </p>
          <ul>
            <li>Energy-efficient lighting control</li>
            <li>Access control and security</li>
            <li>HVAC automation and monitoring</li>
            <li>Conference room and AV systems</li>
          </ul>
        </div>
        <a
          class="gap-0-5 justify-content-flex-end"
          href="/portfolio/professional"
        >
          View projects <ArrowForward />
        </a>
      </Card>
    </div>
    <section class="gap grid justify-content-center text-align-center">
      <h2>Let's Get Started!</h2>
      <p>
        Let's connect and design the perfect smart home solution for your space.
      </p>
      <div class="gap grid justify-content-center">
        <button-component href="/contact" class="min-width-25vw">
          Get in Touch
          <ArrowForward />
        </button-component>
      </div>
    </section>
  </div>
</Layout>

<script>
  import '@components/button';
</script>
