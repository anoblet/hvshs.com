---
import PricingCard from '@components/PricingCard.astro';
import Layout from '@layouts/default.astro';
---

<Layout
  title="Pricing"
  description="Transparent pricing for smart home services in the Hudson Valley. Choose from flexible plans that include professional design, installation, and ongoing support. Get started today."
>
  <h1 class="text-align-center font-size-2 margin-bottom-2">Pricing</h1>
  <p
    class="hero-description text-align-center margin-bottom-4 max-width-48 margin-auto"
  >
    Select the plan that suits your goals. Every plan includes professional
    design, quality installation, and ongoing support.
  </p>

  <div class="flex gap-2 justify-center margin-bottom-4">
    <a
      href="/services/design/pricing"
      class="button button-primary font-size-1-125"
    >
      Design Pricing
    </a>
    <a
      href="/services/installation/pricing"
      class="button button-primary font-size-1-125"
    >
      Installation Pricing
    </a>
    <a
      href="/services/consultation/pricing"
      class="button button-primary font-size-1-125"
    >
      Consultation Pricing
    </a>
  </div>
  <div class="grid auto-fit-20 gap-2 width-100 max-width-64 margin-auto">
    <PricingCard
      title="Essential"
      description="Perfect for homeowners looking to get started with a smart home essentials package."
      features={[
        'Smart hub setup',
        'Lighting controls',
        'Smart thermostat install',
        'Email support',
      ]}
      price="$999"
      buttonText="Get Started"
      buttonHref="/contact"
    />
    <PricingCard
      title="Whole Home"
      description="Designed for homes wanting full automation with security, climate, and entertainment."
      features={[
        'Whole-home automation',
        'Security system setup',
        'Custom scenes & routines',
        'Priority support',
      ]}
      price="$2,499"
      buttonText="Get Started"
      buttonHref="/contact"
    />
  </div>
</Layout>
