---
import PricingCard from '@components/PricingCard.astro';
import Layout from '@layouts/default.astro';
---

<Layout
  title="Pricing"
  description="Transparent pricing for smart home services in the Hudson Valley. Choose from flexible plans that include professional design, installation, and ongoing support. Get started today."
>
  <h1 class="text-align-center font-size-2 margin-bottom-2">Pricing</h1>
  <p
    class="hero-description text-align-center margin-bottom-4 max-width-48 margin-auto"
  >
    Choose a monthly service plan for ongoing smart home guidance, maintenance,
    and support. One-time setup work is included where noted.
  </p>

  <div class="flex gap-2 justify-center margin-bottom-4">
    <a
      href="/services/design/pricing"
      class="button button-primary font-size-1-125"
    >
      Design plans
    </a>
    <a
      href="/services/installation/pricing"
      class="button button-primary font-size-1-125"
    >
      Installation plans
    </a>
    <a
      href="/services/consultation/pricing"
      class="button button-primary font-size-1-125"
    >
      Consultation plans
    </a>
  </div>
  <div class="grid auto-fit-20 gap-2 width-100 max-width-64 margin-auto">
    <PricingCard
      title="Essential"
      description="A monthly foundation for homeowners getting started with a smart home essentials package."
      features={[
        'Smart hub onboarding',
        'Lighting and thermostat setup',
        'Monthly system check-in',
        'Email support',
      ]}
      price="$99"
      billingPeriod=" / month"
      buttonText="Start subscription"
      buttonHref="/contact"
    />
    <PricingCard
      title="Whole Home"
      description="Ongoing whole-home automation support for security, climate, and entertainment systems."
      features={[
        'Whole-home onboarding',
        'Security and climate setup',
        'Custom scenes and routines',
        'Monthly optimization review',
        'Priority support',
      ]}
      price="$249"
      billingPeriod=" / month"
      buttonText="Start subscription"
      buttonHref="/contact"
    />
  </div>
</Layout>
