---

<Layout title="Memory">
  <div class="max-width-56 width-100 margin-auto column flex gap-2">
    <section class="gap grid justify-content-center text-align-center">
      <h1>Memory</h1>
      <p class="hero-description text-align-center">
        Explore the knowledge graph and project memory. This page displays all
        tracked entities, preferences, and project context for
        astronautical-apogee.
      </p>
    </section>
    <card-component>
      <MemoryViewer memory={memory} />
    </card-component>
  </div>
</Layout>
<script>
  import '@components/card';
</script>
