---
import walkwayFoggy from '@assets/images/hudson-valley/walkway-foggy.jpg';
import SmartImage from '@components/SmartImage.astro';
import { getCollection } from 'astro:content';
import Layout from '../layouts/default.astro';

const postCollection = await getCollection('blog');

const posts = postCollection.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<Layout
  title="Blog"
  description="Smart home tips, guides, and updates from Hudson Valley Smart Home Solutions. Discover new ideas about home automation, energy efficiency, security, and getting the most from your smart devices."
>
  <div class="gap grid max-width-56 width-100">
    <h1 class="text-align-center">Blog</h1>
    <SmartImage
      src={walkwayFoggy}
      alt="Walkway Over the Hudson railroad bridge spanning the Hudson River"
      loading="eager"
    />
    <p class="text-align-center">
      Discover new ideas, stories, and updates. Dive into topics that inspire,
      inform, and spark conversation—from home automation to energy efficiency.
    </p>
    <span></span>
    <ul class="gap-2 list">
      {
        posts.map(post => (
          <li class="gap-0-25 grid">
            <div class="gap-0-5 grid">
              <span class="color-tertiary font-weight-700">
                {new Date(post.data.date).toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </span>
              <hr />
              <a class="font-weight-6" href={'/blog/' + post.id}>
                {post.data.title}
              </a>
            </div>
            <div>{post.data.description}</div>
          </li>
        ))
      }
    </ul>
  </div>
</Layout>
<style>
  ul,
  li {
    padding: 0;
  }
</style>
