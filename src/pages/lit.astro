---
import aqaraLogo from '@assets/logos/aqara.svg';
import bluetoothLogo from '@assets/logos/bluetooth.svg';
import philipsHueLogo from '@assets/logos/philips-hue.svg';
import thirdRealityLogo from '@assets/logos/third-reality.svg';
import wifiLogo from '@assets/logos/wifi.svg';
import zWaveLogo from '@assets/logos/z-wave.svg';
import zigbeeLogo from '@assets/logos/zigbee.svg';
import Layout from '../layouts/default.astro';
---

<Layout
  title="Technology"
  description="The smart home platforms and technologies we support at Hudson Valley Smart Home Services - lighting, climate, security, entertainment, and voice assistants from the industry's leading brands."
>
  <div class="grid gap-3 page">
    <section class="justify-content-center gap grid text-align-center">
      <h1>Smart Home Technology</h1>
      <p class="hero-description">
        We work with the industry's leading smart home platforms and
        technologies. No matter what ecosystem you prefer, we design, install,
        and integrate systems that work together seamlessly.
      </p>
    </section>
    <section class="gap grid">
      <h2>Platforms We Support</h2>
      <div class="grid auto-fit-15 gap-2">
        <div class="step-card">
          <h3>Amazon Alexa</h3>
          <p>Voice control for lighting, climate, entertainment, and more.</p>
        </div>
        <div class="step-card">
          <h3>Google Home</h3>
          <p>
            Google Assistant integration for hands-free control throughout your
            home.
          </p>
        </div>
        <div class="step-card">
          <h3>Apple HomeKit</h3>
          <p>Secure, private smart home control from your Apple devices.</p>
        </div>
        <div class="step-card">
          <h3>SmartThings</h3>
          <p>
            Flexible hub-based automation that connects hundreds of devices.
          </p>
        </div>
        <div class="step-card">
          <h3>Matter</h3>
          <p>
            The new universal standard that makes devices work across
            ecosystems.
          </p>
        </div>
        <div class="step-card">
          <h3>Home Assistant</h3>
          <p>
            Powerful, local-first automation for advanced users who want full
            control.
          </p>
        </div>
      </div>
    </section>
    <section class="gap grid">
      <h2>Device Brands We Support</h2>
      <div class="grid auto-fit-15 gap-2">
        <div class="step-card text-align-center">
          <img
            class="brand-logo"
            src={aqaraLogo.src}
            alt="Aqara"
            loading="lazy"
          />
          <h3>Aqara</h3>
        </div>
        <div class="step-card text-align-center">
          <img
            class="brand-logo"
            src={philipsHueLogo.src}
            alt="Philips Hue"
            loading="lazy"
          />
          <h3>Philips Hue</h3>
        </div>
        <div class="step-card text-align-center">
          <img
            class="brand-logo"
            src={thirdRealityLogo.src}
            alt="Third Reality"
            loading="lazy"
          />
          <h3>Third Reality</h3>
        </div>
        <div class="step-card text-align-center">
          <img
            class="brand-logo"
            src={zigbeeLogo.src}
            alt="Zigbee"
            loading="lazy"
          />
          <h3>Zigbee</h3>
        </div>
        <div class="step-card text-align-center">
          <img
            class="brand-logo"
            src={zWaveLogo.src}
            alt="Z-Wave"
            loading="lazy"
          />
          <h3>Z-Wave</h3>
        </div>
        <div class="step-card text-align-center">
          <img
            class="brand-logo"
            src={wifiLogo.src}
            alt="Wi-Fi"
            loading="lazy"
          />
          <h3>Wi-Fi</h3>
        </div>
        <div class="step-card text-align-center">
          <img
            class="brand-logo"
            src={bluetoothLogo.src}
            alt="Bluetooth"
            loading="lazy"
          />
          <h3>Bluetooth</h3>
        </div>
      </div>
    </section>
    <section class="gap grid">
      <h2>Device Categories</h2>
      <div class="grid auto-fit-15 gap-2">
        <div class="step-card">
          <h3>Lighting</h3>
          <p>Smart bulbs, switches, dimmers, and scenes from leading brands.</p>
        </div>
        <div class="step-card">
          <h3>Climate</h3>
          <p>Smart thermostats, sensors, and zoned climate control.</p>
        </div>
        <div class="step-card">
          <h3>Security</h3>
          <p>Cameras, doorbells, locks, sensors, and alarm integration.</p>
        </div>
        <div class="step-card">
          <h3>Entertainment</h3>
          <p>Smart TVs, speakers, and whole-home audio systems.</p>
        </div>
        <div class="step-card">
          <h3>Network</h3>
          <p>
            Mesh Wi-Fi, routers, and wired infrastructure for reliable
            connectivity.
          </p>
        </div>
        <div class="step-card">
          <h3>Automation</h3>
          <p>Hubs, scenes, routines, and integrations that connect it all.</p>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .brand-logo {
    display: block;
    height: 4.5rem;
    margin: 0 auto 1rem;
    max-width: 100%;
    object-fit: contain;
  }
</style>
