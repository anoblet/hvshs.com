---
import Layout from '@layouts/default.astro';
---

<Layout title="About Andrew Noblet">
  <div class="max-width-56 width-100 margin-auto column flex gap-2">
    <section class="gap grid justify-content-center text-align-center">
      <h1>Meet Andrew Noblet</h1>
      <p class="bold-5 max-width-56">
        Hello! I'm <strong>Andrew Noblet</strong>, a developer dedicated to
        creating fast, accessible, and modern web experiences. I believe
        technology should empower everyone—making the web simpler, smarter, and
        more inclusive.
      </p>
    </section>
    <card-component>
      <ul class="column flex gap-0-5 font-size-1-125">
        <li><strong>Full Name:</strong> Andrew Noblet</li>
        <li><strong>Born in:</strong> Chile</li>
        <li>
          <strong>Global Experience:</strong> Chile, Puerto Rico, Ohio, and now <strong
            >New York</strong
          >
        </li>
        <li>
          <strong>GitHub:</strong>
          <a href="https://github.com/anoblet" target="_blank" rel="noopener"
            >anoblet</a
          >
        </li>
        <li>
          <strong>Beyond Code:</strong> Skateboarding, snowboarding, and guitar
        </li>
      </ul>
    </card-component>

    <card-component>
      <h2 class="font-size-1-25 margin-bottom-0-5">Values & Approach</h2>
      <ul class="column flex gap-0-5 font-size-1-125">
        <li>Adaptable, open-minded, and always welcoming new perspectives.</li>
        <li>Simplicity, reusable design, and continuous growth.</li>
        <li>Collaboration and clear solutions drive my work.</li>
      </ul>
    </card-component>

    <consultation-component class="margin-top-4"></consultation-component>
  </div>
</Layout>

<script>
  import '@components/card';
  import '@components/button';
  import '@components/consultation';
</script>
