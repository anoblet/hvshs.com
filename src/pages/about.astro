---
import Layout from '@layouts/default.astro';
import Card from '@components/Card.astro';
import SmartImage from '@components/SmartImage.astro';
import devicesImage from '@assets/images/smart-home/devices-on-table-2.jpg';
import approachImage from '@assets/images/smart-home/person-holding-smart-device.jpg';
import catskillsShawangunk from '@assets/images/hudson-valley/catskills-shawangunk.jpg';
---

<Layout
  title="About Us"
  description="Hudson Valley Smart Home Services - Local smart home experts serving the Hudson Valley. Professional design, installation, and management of smart home devices for homes and businesses."
>
  <div class="max-width-56 width-100 margin-auto column flex gap-2">
    <span></span>
    <section class="gap grid justify-content-center text-align-center">
      <h1>About Hudson Valley Smart Home Services</h1>
      <SmartImage
        src={catskillsShawangunk}
        alt="Catskill Mountains and Shawangunk Ridge in the Hudson Valley"
        loading="eager"
      />
      <p>
        We're <strong>Hudson Valley Smart Home Services</strong> — a local team dedicated
        to making smart home technology work seamlessly for homes and businesses
        across the Hudson Valley. From Poughkeepsie to Kingston, from New Paltz to
        Rhinebeck, we design, install, and manage smart home systems that make daily
        life more convenient, efficient, and secure.
      </p>
      <p>
        We believe smart home technology should be simple, reliable, and
        genuinely useful. Whether you're automating your lighting and climate,
        securing your property, or building a whole-home entertainment system,
        we handle everything from initial design to ongoing support.
      </p>
    </section>
    <Card>
      <SmartImage
        src={devicesImage}
        alt="Smart home devices grouped on a table"
      />
      <h2>What We Do</h2>
      <ul class="column flex gap-0-5 padding-horizontal-1">
        <li>
          <strong>Smart Home Design:</strong> Custom system planning tailored to
          your home, lifestyle, and budget
        </li>
        <li>
          <strong>Installation:</strong> Professional setup of lighting, climate,
          security, and entertainment systems
        </li>
        <li>
          <strong>Automation:</strong> Connected scenes, schedules, and routines
          that work automatically
        </li>
        <li>
          <strong>Support & Maintenance:</strong> Ongoing management, troubleshooting,
          and updates
        </li>
        <li>
          <strong>Consultation:</strong> Expert advice on devices, platforms, and
          smart home strategy
        </li>
      </ul>
    </Card>
    <Card>
      <h2>Why Choose Us</h2>
      <div class="column flex gap">
        <div>
          <h3>Local & Trusted</h3>
          <p>
            Based in the Hudson Valley and serving the surrounding community, we
            understand the area's homes, infrastructure, and needs. You get
            personalized service from a team that's close by when you need us.
          </p>
        </div>
        <div>
          <h3>Simpler by Design</h3>
          <p>
            Technology should fade into the background. We follow a minimalist
            philosophy — clean installs, intuitive controls, and systems that
            just work, without overwhelming complexity.
          </p>
        </div>
        <div>
          <h3>End-to-End Service</h3>
          <p>
            From the first consultation to installation, configuration, and
            ongoing support, we manage your smart home so you don't have to.
          </p>
        </div>
      </div>
    </Card>
    <Card>
      <SmartImage src={approachImage} alt="Person holding a smart device" />
      <h2>Our Approach</h2>
      <p>
        Every home is different, so every solution is custom. We start by
        listening — understanding your goals, your daily routines, and your
        budget. Then we design a system around your needs, recommend the right
        devices and platforms, and install everything with care.
      </p>
      <p>
        After installation, we take the time to set up automations, teach you
        how to use your system, and stay available for support as your needs
        evolve. Our goal is a smart home that genuinely improves your everyday
        life — simply and reliably.
      </p>
    </Card>
    <Card>
      <h2>Serving the Hudson Valley</h2>
      <p>
        We proudly serve clients throughout the Hudson Valley region, including
        Dutchess, Ulster, Orange, and surrounding counties. Whether you're a
        homeowner looking to automate your space or a business seeking
        efficient, secure environments, we're here to help.
      </p>
    </Card>
    <section class="gap grid justify-content-center text-align-center">
      <h2>Let's Get Started!</h2>
      <p>
        Ready to make your home smarter? Let's discuss how our smart home
        services can work for you.
      </p>
      <div class="gap grid justify-content-center">
        <button-component href="/contact" class="min-width-25vw">
          Contact
        </button-component>
      </div>
    </section>
  </div>
</Layout>

<script>
  import '@components/button';
</script>
