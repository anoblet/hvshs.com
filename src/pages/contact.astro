---
import Layout from '@layouts/default.astro';
---

<Layout title="Contact & Consultation">
  <div class="max-width-56 width-100 margin-auto column flex gap-2">
    <h1 class="text-align-center">Book a Free Consultation</h1>
    <p class="font-size-1-125 text-align-center">
      Schedule a complimentary 30-minute consultation to discuss your project,
      get expert advice, or ask any questions. All appointments are free and no
      obligation.
    </p>
    <div class="flex justify-content-center margin-top-2 margin-bottom-2">
      <a
        href="https://calendar.app.google/JjnLtVR6mnM11FcS9"
        target="_blank"
        rel="noopener"
      >
        <button-component variant="primary">Book Now</button-component>
      </a>
    </div>
    <div class="margin-top-4">
      <business-card></business-card>
    </div>
  </div>
</Layout>

<script>
  import '@components/business-card';
  import '@components/button';
</script>
