---
import Layout from '../../layouts/default.astro';
import Card from '@components/Card.astro';
---

<Layout
  title="Smart Home Consultation Services"
  description="Expert smart home consultation in the Hudson Valley. Guidance on devices, platforms, troubleshooting, and smart home strategy tailored to your home and lifestyle."
>
  <div class="grid gap-3 page">
    <section class="column flex gap-2 align-items-center">
      <h1>Consultation & Support</h1>
      <p class="hero-description">
        Get expert guidance for your smart home — from choosing the right
        devices to troubleshooting and long-term strategy. We deliver advice
        that works for your home, budget, and lifestyle.
      </p>
    </section>
    <section class="gap grid">
      <h2>Our Approach</h2>
      <div class="grid auto-fit-15 gap-2">
        <div class="step-card">
          <h3>Assessment</h3>
          <p>Analyze your current setup, challenges, and goals.</p>
        </div>
        <div class="step-card">
          <h3>Strategy</h3>
          <p>
            Tailored recommendations based on your home and what matters to you.
          </p>
        </div>
        <div class="step-card">
          <h3>Implementation</h3>
          <p>Guidance and support during setup and installation.</p>
        </div>
        <div class="step-card">
          <h3>Follow-up</h3>
          <p>
            Ongoing support for successful outcomes and continuous improvement.
          </p>
        </div>
      </div>
    </section>
    <section class="gap grid">
      <h2>Consultation Services</h2>
      <div class="column gap grid">
        <Card>
          <h3>Smart Home Assessment</h3>
          <p>
            A walkthrough of your home and current technology with clear,
            prioritized recommendations for improvement.
          </p>
          <ul>
            <li>Home technology walkthrough</li>
            <li>Device inventory and audit</li>
            <li>Connectivity assessment</li>
            <li>Prioritized recommendations</li>
          </ul>
        </Card>
        <Card>
          <h3>Device & Platform Advice</h3>
          <p>
            Guidance on the best devices and platforms for your needs, budget,
            and existing ecosystem.
          </p>
          <ul>
            <li>Device selection guidance</li>
            <li>Platform compatibility review</li>
            <li>Budget-friendly options</li>
            <li>Ecosystem recommendations</li>
          </ul>
        </Card>
        <Card>
          <h3>Home Network Planning</h3>
          <p>
            A solid network is the backbone of every smart home. We plan and
            optimize connectivity for reliable performance everywhere.
          </p>
          <ul>
            <li>Network requirements analysis</li>
            <li>Wi-Fi coverage planning</li>
            <li>Router and access point advice</li>
            <li>Security best practices</li>
          </ul>
        </Card>
        <Card>
          <h3>Troubleshooting & Repairs</h3>
          <p>
            Expert diagnosis and resolution of smart home issues — from
            unresponsive devices to frustrating automations.
          </p>
          <ul>
            <li>Device troubleshooting</li>
            <li>Automation debugging</li>
            <li>Connectivity fixes</li>
            <li>Emergency support</li>
          </ul>
        </Card>
        <Card>
          <h3>Automation Design</h3>
          <p>
            Design meaningful automations — scenes, schedules, and routines that
            make your home genuinely easier to live in.
          </p>
          <ul>
            <li>Scene and routine design</li>
            <li>Trigger and condition planning</li>
            <li>Voice control setup</li>
            <li>Energy-saving automations</li>
          </ul>
        </Card>
        <Card>
          <h3>Ongoing Support</h3>
          <p>
            Maintenance and support plans that keep your smart home running
            smoothly, with expert help whenever you need it.
          </p>
          <ul>
            <li>Device updates and maintenance</li>
            <li>System health checks</li>
            <li>New device integration</li>
            <li>Priority support</li>
          </ul>
        </Card>
      </div>
    </section>
    <consultation-component></consultation-component>
  </div>
</Layout>

<script>
  import '@components/consultation';
</script>
