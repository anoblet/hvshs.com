---
import PricingCard from '@components/PricingCard.astro';
import Layout from '@layouts/default.astro';
---

<Layout
  title="Smart Home Consultation Pricing"
  description="Subscription plans for ongoing smart home consultation, guidance, and prioritized support. One-time sessions remain available for focused projects."
>
  <h1 class="text-align-center font-size-2 margin-bottom-2">
    Consultation Pricing
  </h1>
  <p
    class="hero-description text-align-center margin-bottom-4 max-width-48 margin-auto"
  >
    Get a recurring partner for decisions, improvements, and troubleshooting.
    One-time consultations remain available for focused project needs.
  </p>

  <div class="grid auto-fit-20 gap-2 width-100 max-width-64 margin-auto">
    <PricingCard
      title="Guidance"
      description="A monthly source of fast answers and second opinions for your smart home."
      features={[
        'One 30-minute session monthly',
        'Device advice',
        'Actionable next steps',
        'Ongoing email follow-up',
      ]}
      price="$39"
      billingPeriod=" / month"
      buttonText="Choose plan"
      buttonHref="/contact"
    />
    <PricingCard
      title="Advisory"
      description="Ongoing strategic advice for homeowners managing a larger or evolving system."
      features={[
        'One 1-hour session monthly',
        'Quarterly home setup review',
        'Written recommendations',
        'Priority ongoing support',
      ]}
      price="$89"
      billingPeriod=" / month"
      buttonText="Choose plan"
      buttonHref="/contact"
    />
  </div>
</Layout>
