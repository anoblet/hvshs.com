---
import PricingCard from '@components/PricingCard.astro';
import Layout from '@layouts/default.astro';
---

<Layout
  title="Smart Home Consultation Pricing"
  description="Expert smart home consultation pricing plans. Guidance and advice to improve your smart home. Choose consultation plans that fit your specific needs and timeline."
>
  <h1 class="text-align-center font-size-2 margin-bottom-2">
    Consultation Pricing
  </h1>
  <p
    class="hero-description text-align-center margin-bottom-4 max-width-48 margin-auto"
  >
    Expert guidance and strategic advice to improve your smart home. Choose the
    consultation plan that fits your needs.
  </p>

  <div class="grid auto-fit-20 gap-2 width-100 max-width-64 margin-auto">
    <PricingCard
      title="Quick Consult"
      description="For those needing fast answers or a second opinion on a specific device or setup."
      features={[
        '30-minute session',
        'Device advice',
        'Actionable next steps',
        'Email follow-up',
      ]}
      price="$99"
      buttonText="Book Now"
      buttonHref="/contact"
    />
    <PricingCard
      title="Project Consult"
      description="For homeowners seeking an in-depth review of their smart home and recommendations."
      features={[
        '1-hour session',
        'Home setup review',
        'Written recommendations',
        'Priority email support',
      ]}
      price="$299"
      buttonText="Book Now"
      buttonHref="/contact"
    />
  </div>
</Layout>
