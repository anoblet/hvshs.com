---
import PricingCard from '@components/PricingCard.astro';
import Layout from '@layouts/default.astro';
---

<Layout
  title="Smart Home Design Pricing"
  description="Professional smart home design pricing plans for the Hudson Valley. Custom system planning for lighting, climate, security, and entertainment. Choose flexible pricing options that fit your vision and budget."
>
  <h1 class="text-align-center font-size-2 margin-bottom-2">
    Smart Home Design Pricing
  </h1>
  <p
    class="hero-description text-align-center margin-bottom-4 max-width-48 margin-auto"
  >
    Professional, custom smart home system design tailored to your home and
    lifestyle. Choose the plan that fits your vision.
  </p>

  <div class="grid auto-fit-20 gap-2 width-100 max-width-64 margin-auto">
    <PricingCard
      title="Starter Design"
      description="For homeowners wanting a smart home plan for a single room or focused system."
      features={[
        'Home technology assessment',
        'Single-room design',
        'Device & platform selection',
        'Email support',
      ]}
      price="$499"
      buttonText="Get Design"
      buttonHref="/contact"
    />
    <PricingCard
      title="Pro Design"
      description="For homes seeking a comprehensive whole-home smart system design."
      features={[
        'Full-home assessment',
        'Whole-home system design',
        'Automation planning',
        'Priority support',
      ]}
      price="$999"
      buttonText="Get Design"
      buttonHref="/contact"
    />
  </div>
</Layout>
