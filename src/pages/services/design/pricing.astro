---
import PricingCard from '@components/PricingCard.astro';
import Layout from '@layouts/default.astro';
---

<Layout
  title="Smart Home Design Pricing"
  description="Subscription plans for ongoing smart home design guidance in the Hudson Valley, with custom system planning and support."
>
  <h1 class="text-align-center font-size-2 margin-bottom-2">
    Smart Home Design Pricing
  </h1>
  <p
    class="hero-description text-align-center margin-bottom-4 max-width-48 margin-auto"
  >
    Get ongoing design guidance tailored to your home and lifestyle. Initial
    assessment and planning are included in the subscription.
  </p>

  <div class="grid auto-fit-20 gap-2 width-100 max-width-64 margin-auto">
    <PricingCard
      title="Design Care"
      description="Ongoing guidance for a single room or focused smart home system."
      features={[
        'Initial technology assessment',
        'Single-room design plan',
        'Device & platform selection',
        'Monthly design check-in',
        'Email support',
      ]}
      price="$49"
      billingPeriod=" / month"
      buttonText="Choose plan"
      buttonHref="/contact"
    />
    <PricingCard
      title="Whole-Home Design"
      description="Comprehensive ongoing planning for homes with evolving smart systems."
      features={[
        'Full-home assessment',
        'Whole-home system plan',
        'Automation planning',
        'Monthly optimization review',
        'Priority support',
      ]}
      price="$99"
      billingPeriod=" / month"
      buttonText="Choose plan"
      buttonHref="/contact"
    />
  </div>
</Layout>
