---
import Layout from '../../layouts/default.astro';
import Card from '@components/Card.astro';
import SmartImage from '@components/SmartImage.astro';
import ArrowForward from '@icons/arrow-forward.svg';
import lightingImage from '@assets/images/smart-home/smart-lighting-candle.jpg';
import climateImage from '@assets/images/smart-home/nest-thermostat-63.jpg';
import securityImage from '@assets/images/smart-home/surveillance-camera-wall.jpg';
---

<Layout
  title="Smart Home Design Services"
  description="Custom smart home design services for the Hudson Valley. Professional planning for lighting, climate, security, and entertainment systems tailored to your home and lifestyle."
>
  <div class="grid gap-3 page">
    <section class="gap-2 grid text-align-center justify-content-center">
      <h1>Smart Home Design</h1>
      <p class="hero-description">
        Custom smart home systems designed around your home, lifestyle, and
        budget. From lighting and climate to security and entertainment, we plan
        every detail so your system works seamlessly together.
      </p>
    </section>
    <section class="gap-2 grid">
      <h2>Our Design Process</h2>
      <div class="grid auto-fit-15 gap-2">
        <div class="step-card">
          <h3>Consultation</h3>
          <p>
            Understand your goals, routines, and needs to inform every design
            decision.
          </p>
        </div>
        <div class="step-card">
          <h3>Home Assessment</h3>
          <p>
            Evaluate your home's layout, wiring, and network to plan the ideal
            system.
          </p>
        </div>
        <div class="step-card">
          <h3>System Design</h3>
          <p>
            Select the right devices and platforms with clear, easy-to-use
            controls.
          </p>
        </div>
        <div class="step-card">
          <h3>Implementation Plan</h3>
          <p>
            Build a step-by-step installation plan with transparent pricing.
          </p>
        </div>
      </div>
    </section>
    <section class="gap-2 grid">
      <h2>Design Services</h2>
      <div class="grid auto-fit-20 gap-2">
        <Card>
          <SmartImage
            src={lightingImage}
            alt="Warm mood lighting from a smart candle"
          />
          <h3>Lighting Design</h3>
          <p>
            Automated lighting for every room—schedules, scenes, and voice
            control that match how you live.
          </p>
          <ul>
            <li>Lighting control design</li>
            <li>Scenes and schedules</li>
            <li>Dimmers and smart switches</li>
            <li>Energy-efficient options</li>
          </ul>
        </Card>
        <Card>
          <SmartImage
            src={climateImage}
            alt="Nest smart thermostat mounted on a wall"
          />
          <h3>Climate & Comfort</h3>
          <p>
            Smart thermostats and climate systems that keep your home
            comfortable while saving energy.
          </p>
          <ul>
            <li>Smart thermostat setup</li>
            <li>Zoned climate control</li>
            <li>Energy monitoring</li>
            <li>Remote management</li>
          </ul>
        </Card>
        <Card>
          <SmartImage
            src={securityImage}
            alt="Security camera mounted on a wall"
          />
          <h3>Security & Safety</h3>
          <p>
            Integrated security systems with cameras, sensors, and smart locks
            for complete peace of mind.
          </p>
          <ul>
            <li>Smart cameras and doorbells</li>
            <li>Motion and entry sensors</li>
            <li>Smart locks</li>
            <li>Alarm integration</li>
          </ul>
        </Card>
      </div>
    </section>

    <div class="flex text-align-center margin-top-4 justify-content-center">
      <button-component
        href="/services/design/pricing"
        variant="primary"
        class="min-width-25vw"
      >
        View Design Pricing
        <ArrowForward />
      </button-component>
    </div>
  </div>
</Layout>

<script>
  import '@components/button';
</script>
