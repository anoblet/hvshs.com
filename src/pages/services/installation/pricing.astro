---
import PricingCard from '@components/PricingCard.astro';
import Layout from '@layouts/default.astro';
---

<Layout
  title="Smart Home Installation Pricing"
  description="Subscription plans for smart home installation support in the Hudson Valley, including onboarding, maintenance, and expert system updates."
>
  <h1 class="text-align-center font-size-2 margin-bottom-2">
    Installation Pricing
  </h1>
  <p
    class="hero-description text-align-center margin-bottom-4 max-width-48 margin-auto"
  >
    Keep your smart home running smoothly with recurring installation support.
    Initial setup and configuration are included where listed.
  </p>

  <div class="grid auto-fit-20 gap-2 width-100 max-width-64 margin-auto">
    <PricingCard
      title="Essential Care"
      description="Ongoing support for a starter system with a few key devices."
      features={[
        'Up to 10 devices',
        'Initial hub and app setup',
        'Network configuration',
        'Monthly maintenance check',
        'Email support',
      ]}
      price="$79"
      billingPeriod=" / month"
      buttonText="Choose plan"
      buttonHref="/contact"
    />
    <PricingCard
      title="Complete Care"
      description="Recurring installation and maintenance for comprehensive systems and integrations."
      features={[
        'Up to 30 devices',
        'Initial security and climate setup',
        'Custom automation updates',
        'Monthly system review',
        'Priority support',
      ]}
      price="$149"
      billingPeriod=" / month"
      buttonText="Choose plan"
      buttonHref="/contact"
    />
  </div>
</Layout>
