---
import '../styles/colors.css';
import '@styles/fonts.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import logo from '@assets/icons/hub_24dp_E3E3E3_FILL0_wght400_GRAD0_opsz24.svg?url';
import { ViewTransitions } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  /** Removes main padding so content (e.g. a hero) fills the full content section */
  fullBleed?: boolean;
}

const {
  title,
  description = 'Astro description',
  fullBleed = false,
} = Astro.props;

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  '@id': 'https://hvshs.com/#business',
  name: 'Hudson Valley Smart Home Services',
  url: 'https://hvshs.com',
  description:
    'Local, vendor-neutral smart home design, installation, and support serving Tarrytown, the Rivertowns, and the lower Hudson Valley.',
  telephone: '+1-914-417-9070',
  email: 'andrewbnoblet@gmail.com',
  priceRange: '$$',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Tarrytown',
    addressRegion: 'NY',
    addressCountry: 'US',
  },
  areaServed: [
    'Tarrytown',
    'Sleepy Hollow',
    'Irvington',
    'Dobbs Ferry',
    'Hastings-on-Hudson',
    'Ardsley',
    'Scarsdale',
    'White Plains',
    'Bronxville',
    'Rye',
    'Hudson Valley',
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Smart Home Services',
    itemListElement: [
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'Smart Home Design',
          url: 'https://hvshs.com/services/design',
        },
      },
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'Smart Home Installation',
          url: 'https://hvshs.com/services/installation',
        },
      },
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'Consultation & Support',
          url: 'https://hvshs.com/services/consultation',
        },
      },
    ],
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={logo} />
    <link rel="canonical" href={`https://hvshs.com${Astro.url.pathname}`} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta
      property="og:url"
      content={`https://hvshs.com${Astro.url.pathname}`}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(localBusinessSchema)}
    />
    <ViewTransitions />
  </head>
  <body>
    <Header />
    <main
      id="main-content"
      class="column flex gap"
      data-full-bleed={fullBleed ? '' : undefined}
    >
      <slot />
    </main>
    <Footer />
    <aside aria-label="Contact">
      <contact-component></contact-component>
    </aside>
    <style>
      *:has(:not(:defined)) {
        opacity: 0;
      }
    </style>
  </body>
</html>
<style>
  * {
  }

  body {
    min-height: 100vh;
  }

  main {
    align-items: center;
    flex: 1;
    padding: 5rem 1rem 1rem;

    p {
      align-items: initial;
    }
  }

  main[data-full-bleed] {
    padding: 0;
  }
</style>
<script>
  import '@components/contact';
  import '@components/social';
  import { globalStyles } from '@styles/global';
  import { applyStoredTheme } from '@utility/theme';

  // Apply global styles
  if (globalStyles.styleSheet) {
    document.adoptedStyleSheets = [
      ...document.adoptedStyleSheets,
      globalStyles.styleSheet,
    ];
  } else {
    console.error('Global styles not loaded');
  }

  applyStoredTheme();

  document.addEventListener('astro:after-swap', applyStoredTheme);
</script>
