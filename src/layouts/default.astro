---
import '../styles/colors.css';
import '@styles/fonts.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Astro description' } = Astro.props;

import { ClientRouter } from 'astro:transitions';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <Header />
    <main id="main-content" class="column flex gap">
      <slot />
    </main>
    <Footer />
    <contact-component></contact-component>
    <theme-toggle></theme-toggle>
    <style>
      .skip-link {
        background: var(--color-accent-500, #19f9d8);
        color: var(--color-neutral-900, #333);
        left: 0;
        padding: 0.75rem 1.5rem;
        position: absolute;
        top: -100px;
        z-index: 1000;
        transition: top 0.2s;
        text-decoration: none;
        font-weight: 600;
        border-radius: 0 0 0.5rem 0.5rem;
      }
      .skip-link:focus {
        top: 0;
        outline: 2px solid var(--color-accent-500, #19f9d8);
      }
    </style>
  </body>
</html>
<style>
  @view-transition {
    navigation: auto;
  }

  * {
  }

  body {
    min-height: 100vh;
    /* opacity: 1; */
    /* transition: opacity 0.2s ease-in-out; */

    &:has(*:not(:defined)) {
      /* opacity: 0; */
    }
  }

  main {
    align-items: center;
    flex: 1;
    padding: 5rem 1rem;

    p {
      align-items: initial;
    }
  }
</style>
<script>
  import '@components/contact';
  import '@components/social';
  import '@components/theme/toggle';
  import { globalStyles } from '@styles/global';
  import media from '@utility/media';
  import { applyStoredTheme } from '@utility/theme';

  media.subscribe((media: string) => {
    document.body.setAttribute('data-media', media);
  });

  // Apply global styles
  if (globalStyles.styleSheet) {
    document.adoptedStyleSheets = [
      ...document.adoptedStyleSheets,
      globalStyles.styleSheet,
    ];
  } else {
    console.error('Global styles not loaded');
  }

  applyStoredTheme();

  document.addEventListener('astro:after-swap', applyStoredTheme);

  let analyticsActivated = false;
  const activateAnalytics = () => {
    if (analyticsActivated) return;
    analyticsActivated = true;
    const w = window as any;
    const d = document;
    const s = 'script';
    const l = 'dataLayer';
    const i = 'GTM-N2FTVHQC';
    w[l] = w[l] || [];
    w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
    const f = d.getElementsByTagName(s)[0];
    const j = d.createElement(s) as HTMLScriptElement;
    const dl = l != 'dataLayer' ? '&l=' + l : '';
    j.async = true;
    j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
    if (f && f.parentNode) f.parentNode.insertBefore(j, f);
  };

  const startIfConsented = () => {
    try {
      if (localStorage.getItem('analytics-consent') === 'granted') {
        if ('requestIdleCallback' in window)
          (window as any).requestIdleCallback(activateAnalytics);
        else setTimeout(activateAnalytics, 0);
        return true;
      }
    } catch {}
    return false;
  };

  const listeners = ['click', 'keydown', 'touchstart', 'scroll'] as const;
  const onInteract = () => {
    listeners.forEach(ev =>
      window.removeEventListener(
        ev,
        onInteract as any,
        { passive: true } as any
      )
    );
    activateAnalytics();
  };
  if (!startIfConsented()) {
    listeners.forEach(ev =>
      window.addEventListener(
        ev,
        onInteract as any,
        { once: true, passive: true } as any
      )
    );
  }
  (window as any).setAnalyticsConsent = (value: 'granted' | 'denied') => {
    try {
      localStorage.setItem('analytics-consent', value);
    } catch {}
    if (value === 'granted') onInteract();
  };
</script>
